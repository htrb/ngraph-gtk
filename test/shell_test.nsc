#! ../src/ngraph -i

set +e

PASS=0
FAIL=0

testeq() {
  NAME=$1
  EXPECT=$2
  ACTUAL=$3

  if test "$EXPECT" = "$ACTUAL"
  then
    PASS=$((PASS + 1))
  else
    echo "$NAME FALSE"
    echo "  EXPECT=<$EXPECT>"
    echo "  ACTUAL=<$ACTUAL>"
    FAIL=$((FAIL + 1))
  fi
}

for t in shell_test_*.nsc
do
    echo
    echo $t
    . ./$t
done

echo
echo "PASS=$PASS"
echo "FAIL=$FAIL"

exit $FAIL
