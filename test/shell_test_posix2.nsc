#!/bin/sh

# Initialize counters
passed=0
failed=0

DASH=0
if [ -z "$NGRAPH" ]; then
    if [ -z "$BASH_VERSION" ]; then
	DASH=1
    fi
fi

# Helper function to run and verify tests
# Usage: assert_eval "expression" "expected_output" "test_description"
assert_eval() {
    expr="$1"
    expected="$2"
    desc="$3"

    # Run arithmetic expansion in the shell
    result=$(($expr))

    if [ "$result" = "$expected" ]; then
        echo "[PASS] $desc ($expr -> $result)"
        passed=$((passed + 1))
    else
        echo "[FAIL] $desc"
        echo "       Expr:     $expr"
        echo "       Expected: $expected"
        echo "       Got:      $result"
        failed=$((failed + 1))
    fi
}

echo "========================================"
echo "Starting POSIX Shell Arithmetic Tests"
echo "========================================"

# 1. Primary & Basic Constants
assert_eval "123" "123" "Decimal constant"
assert_eval "0" "0" "Zero constant"
if [ $DASH -eq 0 ]; then
assert_eval "(1, 2)" "2" "comma"
fi

# 2. Basic Arithmetic (Precedence: * / % over + -)
assert_eval "1 + 2 * 3" "7" "Multiply precedence"
assert_eval "(1 + 2) * 3" "9" "Parentheses precedence"
assert_eval "10 - 4 - 2" "4" "Subtraction left-associativity"
assert_eval "10 / 2 / 2" "2" "Division left-associativity"
assert_eval "7 % 4" "3" "Modulo operator"

# 3. Unary Operators (Precedence: High)
assert_eval "-5" "-5" "Unary minus"
assert_eval "+5" "5" "Unary plus"
assert_eval "!0" "1" "Logical NOT (zero)"
assert_eval "!5" "0" "Logical NOT (non-zero)"
assert_eval "~0" "-1" "Bitwise NOT"

# 4. Bitwise Shift Operators
assert_eval "1 << 3" "8" "Bitwise left shift"
assert_eval "16 >> 2" "4" "Bitwise right shift"

# 5. Relational & Equality Operators (Returns 1 or 0)
assert_eval "5 > 3" "1" "Greater than (true)"
assert_eval "5 < 3" "0" "Less than (false)"
assert_eval "5 >= 5" "1" "Greater than or equal (true)"
assert_eval "5 <= 4" "0" "Less than or equal (false)"
assert_eval "5 == 5" "1" "Equality (true)"
assert_eval "5 != 5" "0" "Inequality (false)"

# 6. Bitwise Logic (And, Xor, Or)
assert_eval "5 & 3" "1" "Bitwise AND (0101 & 0011 -> 0001)"
assert_eval "5 ^ 3" "6" "Bitwise XOR (0101 ^ 0011 -> 0110)"
assert_eval "5 | 3" "7" "Bitwise OR (0101 | 0011 -> 0111)"

# 7. Logical Operators & Short-Circuiting
assert_eval "5 && 3" "1" "Logical AND (true && true)"
assert_eval "5 && 0" "0" "Logical AND (true && false)"
assert_eval "5 || 0" "1" "Logical OR (true || false)"
assert_eval "0 || 0" "0" "Logical OR (false || false)"

# Variables setup for assignment and side-effects tests
x=10
y=20
z=0

# 8. Conditional Operator (Ternary) & Short-Circuiting
assert_eval "1 ? 50 : 100" "50" "Ternary true condition"
assert_eval "0 ? 50 : 100" "100" "Ternary false condition"

# 9. Assignment Operators (Right-associativity)
assert_eval "x = 5" "5" "Simple assignment"
assert_eval "x += 5" "10" "Addition assignment (x is now 10)"
assert_eval "x -= 3" "7" "Subtraction assignment (x is now 7)"
assert_eval "x *= 3" "21" "Subtraction assignment (x is now 21)"
assert_eval "x /= 7" "3" "Subtraction assignment (x is now 3)"
assert_eval "x %= 2" "1" "Subtraction assignment (x is now 3)"
assert_eval "x &= 5" "1" "Subtraction assignment (x is now 1)"
assert_eval "x |= 4" "5" "Subtraction assignment (x is now 5)"
assert_eval "x ^= 3" "6" "Subtraction assignment (x is now 6)"
assert_eval "x <<= 2" "24" "Subtraction assignment (x is now 24)"
assert_eval "x >>= 1" "12" "Subtraction assignment (x is now 12)"

# 10. Postfix / Prefix Increment & Decrement (Side-effects)
# Resetting variables inside evaluation via assignment
if [ $DASH -eq 0 ]; then
assert_eval "x = 5, ++x" "6" "Comma and Prefix increment"
assert_eval "x = 5, x++" "5" "Comma and Postfix increment (returns old val)"
assert_eval "x" "6" "Verify postfix side-effect"
assert_eval "x = 5, --x" "4" "Comma and Prefix decrement"
assert_eval "x = 5, x--" "5" "Comma and Postfix decrement (returns old val)"
assert_eval "x" "4" "Verify postfix side-effect"

# 11. Complex Short-Circuit Validation (Side-effects skip)
assert_eval "x = 10, 0 && ++x" "0" "Logical AND short-circuit skips prefix increment"
assert_eval "x" "10" "Verify x was not incremented"

assert_eval "x = 10, 1 || ++x" "1" "Logical OR short-circuit skips prefix increment"
assert_eval "x" "10" "Verify x was not incremented"

assert_eval "x = 10, 0 ? ++x : 99" "99" "Ternary false skips true-branch increment"
assert_eval "x" "10" "Verify x was not incremented"

assert_eval "x = 10, 1 ? 99 : ++x" "99" "Ternary true skips false-branch increment"
assert_eval "x" "10" "Verify x was not incremented"
fi


echo "========================================"
echo "Test Summary"
echo "========================================"
echo "TOTAL PASSED: $passed"
echo "TOTAL FAILED: $failed"

true $((PASS += passed))
true $((FAIL += failed))

if [ "$failed" -eq 0 ]; then
    echo "Result: ALL TESTS PASSED SUCCESSFULLY!"
else
    echo "Result: SOME TESTS FAILED. PLEASE CHECK LOGS."
fi
