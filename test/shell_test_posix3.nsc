#!/bin/sh
# ==============================================================================
# POSIX Shell Parameter Expansion Test Script
# Target: POSIX-compliant shells (e.g., dash, ash, ksh, bash --posix)
# ==============================================================================

set +e

TOTAL=0
FAILED=0

# アサーション用関数
assert_eq() {
    name="$1"
    expected="$2"
    actual="$3"
    TOTAL=$((TOTAL + 1))
    if [ "$expected" = "$actual" ]; then
        echo "  [PASS] $name"
    else
        echo "  [FAIL] $name"
        echo "         Expected: '$expected'"
        echo "         Got:      '$actual'"
        FAILED=$((FAILED + 1))
    fi
}

echo "=== 1. Expansion of default values (${parameter-word} / ${parameter:-word}) ==="
# With a colon (:), it applies to "unset or empty string"; without it, only to "unset".

# (1) When unset
unset v_unset
assert_eq "unset + '-' (default)" "default" "${v_unset-default}"
assert_eq "unset + ':-' (default)" "default" "${v_unset:-default}"

# (2) When empty string ("")
v_empty=""
assert_eq "empty + '-' (keeps empty)" "" "${v_empty-default}"
assert_eq "empty + ':-' (default for empty)" "default" "${v_empty:-default}"

# (3) When a value exists
v_val="hello"
assert_eq "value + '-' (keeps value)" "hello" "${v_val-default}"
assert_eq "value + ':-' (keeps value)" "hello" "${v_val:-default}"


echo ""
echo "=== 2. Assigning default values (${parameter=word} / ${parameter:=word}) ==="

# (1) When unset (Verification of assignment to a variable)
unset v_unset
res="${v_unset=assigned}"
assert_eq "unset + '=' (returns value)" "assigned" "$res"
assert_eq "unset + '=' (variable is now set)" "assigned" "$v_unset"

unset v_unset
res="${v_unset:=assigned_colon}"
assert_eq "unset + ':=' (returns value)" "assigned_colon" "$res"
assert_eq "unset + ':=' (variable is now set)" "assigned_colon" "$v_unset"

# (2) Case of an empty string ("")
v_empty=""
res="${v_empty=assigned_empty}"
assert_eq "empty + '=' (keeps empty, no assign)" "" "$res"
assert_eq "empty + '=' (var remains empty)" "" "$v_empty"

v_empty=""
res="${v_empty:=assigned_colon_empty}"
assert_eq "empty + ':=' (assigns because empty)" "assigned_colon_empty" "$res"
assert_eq "empty + ':=' (var is now assigned)" "assigned_colon_empty" "$v_empty"


echo ""
echo "=== 3. Expansion of Alternative Values​ (${parameter+word} / ${parameter:+word}) ==="
# Returns an alternative value if the parameter exists (or is set)

unset v_unset
v_empty=""
v_val="exist"

assert_eq "unset + '+'" "" "${v_unset+alt}"
assert_eq "unset + ':+'" "" "${v_unset:+alt}"

assert_eq "empty + '+' (set but empty -> alt)" "alt" "${v_empty+alt}"
assert_eq "empty + ':+' (empty -> no alt)" "" "${v_empty:+alt}"

assert_eq "value + '+'" "alt" "${v_val+alt}"
assert_eq "value + ':+'" "alt" "${v_val:+alt}"


echo ""
echo "=== 4. Deletion via pattern matching (#, ##, %, %%) ==="

str="file.tar.gz"

# (1) Deletion from the beginning (prefix): shortest match (#) / longest match (##)
assert_eq "shortest prefix (#*.)" "tar.gz" "${str#*.}"
assert_eq "longest prefix (##*.)" "gz" "${str##*.}"

# (2) Deletion from the end (suffix): shortest match (%) / longest match (%%)
assert_eq "shortest suffix (%.*)" "file.tar" "${str%.*}"
assert_eq "longest suffix (%%.*)" "file" "${str%%.*}"

# (3) Edge case: No pattern match
assert_eq "no match prefix (#)" "file.tar.gz" "${str#notfound}"
assert_eq "no match suffix (%)" "file.tar.gz" "${str%notfound}"

# (4) Edge case: Empty pattern
assert_eq "empty pattern (#)" "file.tar.gz" "${str#}"
assert_eq "empty pattern (%)" "file.tar.gz" "${str%}"


echo ""
echo "=== 5. Testing bracket expressions ([...]) and negated character classes ([!...]) ==="
str_mix="item_123-abc.txt"

# (4) エッジケース：空パターン
assert_eq "shortest prefix with char class (#*[0-9])" "23-abc.txt" "${str_mix#*[0-9]}"
assert_eq "longest prefix with char class (##*[0-9])" "-abc.txt" "${str_mix##*[0-9]}"

assert_eq "shortest suffix with char class (%[a-z]*)" "item_123-abc.tx" "${str_mix%[a-z]*}"
assert_eq "longest suffix with char class (%%[a-z]*)" "" "${str_mix%%[a-z]*}"

# (2) Deletion using a negated character class ([!...])
str_num="123abc456"

assert_eq "shortest prefix with negated char class (#*[!0-9])" "bc456" "${str_num#*[!0-9]}"
assert_eq "suffix with negated char class (%[!0-9]*)" "123ab" "${str_num%[!0-9]*}"

# (3) Longest match using a negated character class (##, %%)
str_test="123-456-789"
# [!0-9] matches the hyphen (-).
# `##` performs the longest prefix match; it removes everything up to and including the last hyphen, resulting in "789"
assert_eq "longest prefix with negated char class (##*[!0-9])" "789" "${str_test##*[!0-9]}"

# `%%` performs the longest suffix match; it removes everything from the first hyphen (when viewed from the end) to the end of the string, resulting in "123"
assert_eq "longest suffix with negated char class (%%[!0-9]*)" "123" "${str_test%%[!0-9]*}"


echo ""
echo "=== 6. \${#var} test ==="

# 1. Standard alphanumeric characters
var_normal="Hello123"
assert_eq "Standard alphanumeric characters (Hello123)" "8" "${#var_normal}"

# 2. Empty string
var_empty=""
assert_eq "Empty string (\"\")" "0" "${#var_empty}"

# 3. Undefined variable
assert_eq "Undefined variable" "0" "${#safe_unset}"

# 4. Spaces
var_space="   "
assert_eq "Three spaces (   )" "3" "${#var_space}"

# 5. String containing newlines and tabs
var_control=$(printf "A\nB\tC")
assert_eq "Containing newline and tab (A\\nB\\tC)" "5" "${#var_control}"

# 6. String containing a null character (\0)
var_null=$(printf "A\0\0\0\0BCD\0E")
assert_eq "Containing a null character (A\\0\\0\\0BCD\\0E)" "5" "${#var_null}"

# 7. UTF-8 multi-byte characters (Japanese)
var_ja="こんにちは"
assert_eq "日本語 (こんにちは)" "5" "${#var_ja}"

PASS=$((PASS + TOTAL - FAILED))
FAIL=$((FAIL + FAILED))

if [ "$FAILED" -eq 0 ]; then
    echo "  All tests passed!"
else
    echo "  Some tests failed."
fi
